# Never commit a real key. Copy this file to .env and edit the copy.
WAKEINTENT_API_KEY=replace-me
WAKEINTENT_BASE_URL=https://api.openai.com/v1
WAKEINTENT_MODEL=gpt-5-mini

# responses: OpenAI's current Responses API (recommended for OpenAI)
# chat-completions: for providers that expose the compatible Chat Completions API
WAKEINTENT_API_MODE=responses

# GPT-5.5 defaults to medium reasoning. Low is a better starting point for the
# extraction and classification work in this proof of concept.
WAKEINTENT_REASONING_EFFORT=low
WAKEINTENT_TEXT_VERBOSITY=low

# Optional phase overrides. Candidate/memory extraction is classification-like;
# contact decisions retain low reasoning. Both systems use the same split.
WAKEINTENT_EXTRACTION_REASONING_EFFORT=none
WAKEINTENT_DECISION_REASONING_EFFORT=low

# Optional cheaper model for ambiguous relevance routing. When unset, the main
# model is used. Benchmark its recall before enabling it in a frozen evaluation.
# WAKEINTENT_ROUTER_MODEL=gpt-5-mini

# Relevance benchmark controls. Hybrid uses safe local rules first and the model
# for ambiguous cases; model forces every scenario through the model router.
# WAKEINTENT_RELEVANCE_MODE=hybrid
# WAKEINTENT_RELEVANCE_ID=direct-job-fair-cancellation
# WAKEINTENT_RELEVANCE_LIMIT=5
# WAKEINTENT_RELEVANCE_REPEATS=3

# Optional request timeout in milliseconds.
WAKEINTENT_TIMEOUT_MS=60000

# Controlled retry for transient network/408/429/5xx failures.
WAKEINTENT_MAX_RETRIES=1
WAKEINTENT_RETRY_BASE_DELAY_MS=250

# Optional USD prices per one million input/output tokens. Leave unset when unknown.
# WAKEINTENT_INPUT_COST_PER_MILLION_USD=0
# WAKEINTENT_OUTPUT_COST_PER_MILLION_USD=0

# Optional provider-specific headers as a JSON object. Do not put Authorization
# or Content-Type here; WakeIntent manages those itself.
# WAKEINTENT_EXTRA_HEADERS_JSON={"x-provider-header":"value"}

# Evaluation runner defaults to three development scenarios to limit cost.
# Set to all only when you intentionally want to run the full development set.
WAKEINTENT_EVAL_LIMIT=3
