{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wakeintent.dev/schemas/0.1/decision.schema.json",
  "title": "ContactDecision",
  "description": "The result of reevaluating a ContactIntent against current context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "intentId",
    "evaluatedAt",
    "action",
    "reason",
    "evidenceRefs",
    "counterEvidenceRefs",
    "confidence",
    "nextEvaluationAt",
    "policyVersion"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "intentId": { "type": "string", "minLength": 1 },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "action": {
      "type": "string",
      "enum": ["contact", "defer", "cancel", "expire", "silent", "resolve"]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "counterEvidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "nextEvaluationAt": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "policyVersion": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}

