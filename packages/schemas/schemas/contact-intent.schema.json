{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wakeintent.dev/schemas/0.1/contact-intent.schema.json",
  "title": "ContactIntent",
  "description": "A future opportunity to contact a user, derived from conversation evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "subject",
    "reason",
    "target",
    "evidence",
    "notBefore",
    "expiresAt",
    "cancellationHints",
    "priority",
    "interruptionCost",
    "confidence",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["candidate", "active", "resolved", "cancelled", "expired"]
    },
    "subject": { "type": "string", "minLength": 1, "maxLength": 240 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["user", "conversation", "participant"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "notBefore": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "expiresAt": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "cancellationHints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "priority": { "type": "number", "minimum": 0, "maximum": 1 },
    "interruptionCost": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}

